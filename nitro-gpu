#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="Nitro GPU Switcher"
VERSION="1.1.1"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
STATE_HOME="${NITRO_GPU_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/nitro-gpu-switcher}"
BACKUP_HOME="$STATE_HOME/backups"
PROFILE_FILE="$STATE_HOME/active-profile"
ORIGINAL_HOME="$STATE_HOME/original"
INSTALL_BACKUP_HOME="$STATE_HOME/install-backups"
GAMESCOPE_STATE_HOME="$STATE_HOME/gamescope-settings"
NIRI_HOME="${NIRI_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/niri}"
NIRI_DEBUG="$NIRI_HOME/config/debug.kdl"
NIRI_ENV="$NIRI_HOME/config/environment.kdl"
SYSTEM_ENV="${SYSTEM_ENV:-/etc/environment}"
GTA_APP_ID="${GTA_APP_ID:-9d2d0eb64d5c44529cece33fe2a46482}"
HEROIC_HOME="${HEROIC_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/heroic}"
HEROIC_GAMES_DIR="$HEROIC_HOME/GamesConfig"
HEROIC_GLOBAL="$HEROIC_HOME/config.json"
HEROIC_CONFIG="${HEROIC_GTA_CONFIG:-$HEROIC_GAMES_DIR/$GTA_APP_ID.json}"
LOCAL_APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

if [[ -t 1 ]]; then
  RESET=$'\033[0m'; BOLD=$'\033[1m'; DIM=$'\033[2m'
  CYAN=$'\033[38;5;45m'; BLUE=$'\033[38;5;75m'; GREEN=$'\033[38;5;84m'
  YELLOW=$'\033[38;5;220m'; RED=$'\033[38;5;203m'; PURPLE=$'\033[38;5;141m'
else
  RESET=''; BOLD=''; DIM=''; CYAN=''; BLUE=''; GREEN=''; YELLOW=''; RED=''; PURPLE=''
fi

info()    { printf '%s●%s %s\n' "$CYAN" "$RESET" "$*"; }
success() { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn()    { printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*"; }
die()     { printf '%s✕%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

banner() {
  clear 2>/dev/null || true
  printf '%s%s' "$BOLD" "$CYAN"
  cat <<'EOF'
  ╭──────────────────────────────────────────╮
  │          NITRO  GPU  SWITCHER            │
  │       Intel  ◉──────◉  NVIDIA            │
  ╰──────────────────────────────────────────╯
EOF
  printf '%s%s  v%s · Niri + Heroic%s\n\n' "$RESET" "$DIM" "$VERSION" "$RESET"
}

require_commands() {
  local command
  for command in python3 realpath readlink; do
    command -v "$command" >/dev/null || die "Dependência ausente: $command"
  done
}

render_node_for_vendor() {
  local wanted="$1" node vendor resolved candidate
  for node in /sys/class/drm/renderD*/device/vendor; do
    [[ -r "$node" ]] || continue
    vendor=$(<"$node")
    [[ "$vendor" == "$wanted" ]] || continue
    resolved="/dev/dri/$(basename "$(dirname "$(dirname "$node")")")"
    for candidate in /dev/dri/by-path/*-render; do
      [[ -L "$candidate" ]] || continue
      if [[ "$(realpath "$candidate")" == "$(realpath "$resolved")" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
    printf '%s\n' "$resolved"
    return 0
  done
  return 1
}

detect_hardware() {
  INTEL_RENDER="${INTEL_RENDER:-$(render_node_for_vendor 0x8086 || true)}"
  NVIDIA_RENDER="${NVIDIA_RENDER:-$(render_node_for_vendor 0x10de || true)}"
  [[ -n "$INTEL_RENDER" && -e "$INTEL_RENDER" ]] || die "GPU Intel não encontrada."
  [[ -n "$NVIDIA_RENDER" && -e "$NVIDIA_RENDER" ]] || die "GPU NVIDIA não encontrada."
}

current_profile() {
  if [[ -r "$PROFILE_FILE" ]]; then
    cat "$PROFILE_FILE"
    return
  fi
  local renderer=''
  renderer=$(sed -n 's/.*render-drm-device "\([^"]*\)".*/\1/p' "$NIRI_DEBUG" 2>/dev/null | head -n1)
  if [[ "$renderer" == *"01:00.0"* || "$renderer" == *"renderD128"* ]]; then
    printf 'nvidia\n'
  elif grep -q '"nvidiaPrime": true' "$HEROIC_CONFIG" 2>/dev/null; then
    printf 'hybrid\n'
  else
    printf 'intel\n'
  fi
}

profile_name() {
  case "$1" in
    nvidia) printf '100%% NVIDIA' ;;
    intel)  printf '100%% Intel' ;;
    hybrid) printf 'Híbrido recomendado' ;;
    restored) printf 'Configuração original' ;;
    *)      printf 'Desconhecido' ;;
  esac
}

show_status() {
  detect_hardware
  local profile renderer vram
  profile=$(current_profile)
  renderer=$(sed -n 's/.*render-drm-device "\([^"]*\)".*/\1/p' "$NIRI_DEBUG" 2>/dev/null | head -n1)
  vram=$(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader 2>/dev/null | head -n1 || printf 'indisponível')

  printf '%s╭─ Estado atual ───────────────────────────╮%s\n' "$BLUE" "$RESET"
  printf '  Perfil       %s%s%s\n' "$BOLD" "$(profile_name "$profile")" "$RESET"
  printf '  Niri         %s\n' "${renderer:-não configurado}"
  printf '  Intel        %s\n' "$INTEL_RENDER"
  printf '  NVIDIA       %s\n' "$NVIDIA_RENDER"
  printf '  VRAM NVIDIA  %s\n' "$vram"
  printf '%s╰─────────────────────────────────────────╯%s\n' "$BLUE" "$RESET"
}

backup_files() {
  BACKUP_DIR="$BACKUP_HOME/$(date +%Y%m%d-%H%M%S)-$$"
  mkdir -p "$BACKUP_DIR"
  [[ -f "$NIRI_DEBUG" ]] && cp -a "$NIRI_DEBUG" "$BACKUP_DIR/debug.kdl"
  [[ -f "$NIRI_ENV" ]] && cp -a "$NIRI_ENV" "$BACKUP_DIR/environment.kdl"
  [[ -f "$HEROIC_GLOBAL" ]] && cp -a "$HEROIC_GLOBAL" "$BACKUP_DIR/heroic-global.json"
  [[ -d "$HEROIC_GAMES_DIR" ]] && cp -a "$HEROIC_GAMES_DIR" "$BACKUP_DIR/GamesConfig"
  [[ -r "$SYSTEM_ENV" ]] && cp -a "$SYSTEM_ENV" "$BACKUP_DIR/system-environment"
  info "Backup: $BACKUP_DIR"
}

capture_originals() {
  mkdir -p "$ORIGINAL_HOME/heroic-games"

  # Migra o backup criado pela versão 1.0, caso o primeiro perfil já tenha sido aplicado.
  local earliest
  earliest=$(find "$BACKUP_HOME" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | head -n1 || true)
  if [[ ! -f "$ORIGINAL_HOME/niri-debug.kdl" ]]; then
    if [[ -n "$earliest" && -f "$earliest/debug.kdl" ]]; then
      cp -a "$earliest/debug.kdl" "$ORIGINAL_HOME/niri-debug.kdl"
      cp -a "$earliest/environment.kdl" "$ORIGINAL_HOME/niri-environment.kdl"
      cp -a "$earliest/system-environment" "$ORIGINAL_HOME/system-environment"
      [[ -f "$earliest/heroic-gta.json" ]] && cp -a "$earliest/heroic-gta.json" "$ORIGINAL_HOME/heroic-games/$GTA_APP_ID.json"
    else
      cp -a "$NIRI_DEBUG" "$ORIGINAL_HOME/niri-debug.kdl"
      cp -a "$NIRI_ENV" "$ORIGINAL_HOME/niri-environment.kdl"
      cp -a "$SYSTEM_ENV" "$ORIGINAL_HOME/system-environment"
    fi
  fi

  [[ -f "$ORIGINAL_HOME/heroic-global.json" || ! -f "$HEROIC_GLOBAL" ]] || cp -a "$HEROIC_GLOBAL" "$ORIGINAL_HOME/heroic-global.json"
  local config destination
  if [[ -d "$HEROIC_GAMES_DIR" ]]; then
    for config in "$HEROIC_GAMES_DIR"/*.json; do
      [[ -f "$config" ]] || continue
      destination="$ORIGINAL_HOME/heroic-games/$(basename "$config")"
      [[ -f "$destination" ]] || cp -a "$config" "$destination"
    done
  fi
}

set_niri_renderer() {
  local renderer="$1"
  python3 - "$NIRI_DEBUG" "$renderer" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
renderer = sys.argv[2]
text = path.read_text()
replacement = f'render-drm-device "{renderer}"'
if re.search(r'render-drm-device\s+"[^"]+"', text):
    text = re.sub(r'render-drm-device\s+"[^"]+"(?:\s*//[^\n]*)?', replacement, text, count=1)
else:
    text = re.sub(r'debug\s*\{', 'debug {\n\t' + replacement, text, count=1)
path.write_text(text)
PY
}

set_niri_environment() {
  local profile="$1"
  python3 - "$NIRI_ENV" "$profile" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
profile = sys.argv[2]
text = path.read_text()
if profile == "nvidia":
    values = {
        "__NV_PRIME_RENDER_OFFLOAD": '"1"',
        "__GLX_VENDOR_LIBRARY_NAME": '"nvidia"',
        "GBM_BACKEND": '"nvidia-drm"',
        "DRI_PRIME": '"1"',
    }
else:
    values = {
        "__NV_PRIME_RENDER_OFFLOAD": "null",
        "__GLX_VENDOR_LIBRARY_NAME": "null",
        "GBM_BACKEND": "null",
        "DRI_PRIME": "null" if profile == "hybrid" else '"0"',
    }
for key, value in values.items():
    pattern = rf'(?m)^(\s*){re.escape(key)}\s+(?:"[^"]*"|null)\s*$'
    if re.search(pattern, text):
        text = re.sub(pattern, lambda m: f'{m.group(1)}{key} {value}', text, count=1)
    else:
        text = re.sub(r'environment\s*\{', f'environment {{\n  {key} {value}', text, count=1)
path.write_text(text)
PY
}

set_system_environment() {
  local profile="$1" temp
  temp=$(mktemp)
  python3 - "$SYSTEM_ENV" "$profile" >"$temp" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
profile = sys.argv[2]
lines = path.read_text().splitlines()
managed = {"__NV_PRIME_RENDER_OFFLOAD", "__GLX_VENDOR_LIBRARY_NAME"}
lines = [line for line in lines if line.split("=", 1)[0].strip() not in managed]
if profile == "nvidia":
    lines.extend(["__NV_PRIME_RENDER_OFFLOAD=1", "__GLX_VENDOR_LIBRARY_NAME=nvidia"])
print("\n".join(lines).rstrip() + "\n")
PY
  if cmp -s "$temp" "$SYSTEM_ENV"; then
    rm -f "$temp"
    return
  fi
  sudo install -m 0644 "$temp" "$SYSTEM_ENV"
  rm -f "$temp"
}

set_heroic_profile() {
  local profile="$1"
  [[ -d "$HEROIC_GAMES_DIR" ]] || { warn "Diretório do Heroic não encontrado; etapa ignorada."; return; }
  python3 - "$HEROIC_GLOBAL" "$HEROIC_GAMES_DIR" "$profile" <<'PY'
import json, pathlib, sys
global_path, games_dir, profile = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
use_nvidia = profile in {"nvidia", "hybrid"}
managed = {
    "__NV_PRIME_RENDER_OFFLOAD", "__GLX_VENDOR_LIBRARY_NAME",
    "__VK_LAYER_NV_optimus", "DRI_PRIME", "DXVK_FILTER_DEVICE_NAME"
}

def configure(settings):
    options = [item for item in settings.get("enviromentOptions", [])
               if isinstance(item, dict) and item.get("key") not in managed]
    settings["nvidiaPrime"] = use_nvidia
    if use_nvidia:
        options += [
            {"key": "__NV_PRIME_RENDER_OFFLOAD", "value": "1"},
            {"key": "__GLX_VENDOR_LIBRARY_NAME", "value": "nvidia"},
            {"key": "__VK_LAYER_NV_optimus", "value": "NVIDIA_only"},
            {"key": "DRI_PRIME", "value": "1"},
        ]
    else:
        options += [
            {"key": "DRI_PRIME", "value": "0"},
            {"key": "DXVK_FILTER_DEVICE_NAME", "value": "Intel"},
        ]
    settings["enviromentOptions"] = options

if global_path.is_file():
    data = json.loads(global_path.read_text())
    defaults = data.get("defaultSettings")
    if isinstance(defaults, dict):
        configure(defaults)
        global_path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")

for path in sorted(games_dir.glob("*.json")):
    data = json.loads(path.read_text())
    changed = False
    for key, settings in data.items():
        if key != "version" and isinstance(settings, dict):
            configure(settings)
            changed = True
    if changed:
        path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
PY
  success "Heroic configurado para todos os jogos atuais e futuros"
}

manage_gamescope_compatibility() {
  local profile="$1"
  [[ -d "$HEROIC_GAMES_DIR" ]] || return
  python3 - "$HEROIC_GAMES_DIR" "$GAMESCOPE_STATE_HOME" "$profile" <<'PY'
import json, pathlib, sys
games_dir, state_dir, profile = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
state_dir.mkdir(parents=True, exist_ok=True)

for path in sorted(games_dir.glob("*.json")):
    data = json.loads(path.read_text())
    state_path = state_dir / path.name
    changed = False

    if profile == "hybrid":
        saved = {}
        if state_path.is_file():
            saved = json.loads(state_path.read_text())
        for app_id, settings in data.items():
            if app_id != "version" and isinstance(settings, dict) and "gamescope" in settings:
                saved[app_id] = settings.pop("gamescope")
                changed = True
        if saved:
            state_path.write_text(json.dumps(saved, indent=2, ensure_ascii=False) + "\n")
    elif state_path.is_file():
        saved = json.loads(state_path.read_text())
        for app_id, gamescope in saved.items():
            settings = data.get(app_id)
            if isinstance(settings, dict):
                settings["gamescope"] = gamescope
                changed = True

    if changed:
        path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
PY
  if [[ "$profile" == hybrid ]]; then
    success "Gamescope desativado no Heroic para proteger Niri/Intel"
  else
    success "Preferências de Gamescope restauradas para este perfil"
  fi
}

ensure_intel_vulkan() {
  command -v pacman >/dev/null || return
  if pacman -Q vulkan-intel lib32-vulkan-intel >/dev/null 2>&1; then
    return
  fi
  warn "Drivers Vulkan Intel ausentes. Eles são necessários para o perfil Intel completo."
  if [[ -t 0 ]]; then
    read -r -p "  Instalar vulkan-intel e lib32-vulkan-intel agora? [S/n] " answer
    if [[ ! "$answer" =~ ^[Nn]$ ]]; then
      sudo pacman -S --needed vulkan-intel lib32-vulkan-intel
    fi
  fi
}

validate_niri() {
  if command -v niri >/dev/null; then
    if ! niri validate >/dev/null; then
      die "A validação do Niri falhou. Restaure os arquivos em $BACKUP_DIR"
    fi
    success "Configuração do Niri validada"
  fi
}

restore_originals() {
  [[ -f "$ORIGINAL_HOME/niri-debug.kdl" ]] || die "Nenhum estado original foi registrado ainda."
  backup_files
  info "Restaurando o estado anterior à primeira troca de perfil..."

  sudo install -m 0644 "$ORIGINAL_HOME/system-environment" "$SYSTEM_ENV"
  cp -a "$ORIGINAL_HOME/niri-debug.kdl" "$NIRI_DEBUG"
  cp -a "$ORIGINAL_HOME/niri-environment.kdl" "$NIRI_ENV"
  [[ -f "$ORIGINAL_HOME/heroic-global.json" ]] && cp -a "$ORIGINAL_HOME/heroic-global.json" "$HEROIC_GLOBAL"

  local config
  for config in "$ORIGINAL_HOME/heroic-games"/*.json; do
    [[ -f "$config" ]] || continue
    cp -a "$config" "$HEROIC_GAMES_DIR/$(basename "$config")"
  done

  validate_niri
  mkdir -p "$STATE_HOME"
  printf 'restored\n' >"$PROFILE_FILE"
  success "Configurações originais restauradas"
  printf '\n%sEncerre e entre novamente na sessão para concluir.%s\n' "$BOLD" "$RESET"
}

uninstall_switcher() {
  if [[ -f "$ORIGINAL_HOME/niri-debug.kdl" ]]; then
    restore_originals
  else
    warn "Não há configurações alteradas para restaurar."
  fi

  local desktop name backup
  for name in steam.desktop com.heroicgameslauncher.hgl.desktop; do
    desktop="$LOCAL_APPS/$name"
    backup="$INSTALL_BACKUP_HOME/$name"
    if [[ -f "$backup" ]]; then
      cp -a "$backup" "$desktop"
    elif grep -q 'Nitro GPU Switcher' "$desktop" 2>/dev/null; then
      rm -f "$desktop"
    fi
  done

  for name in steam heroic; do
    if [[ -L "$HOME/.local/bin/$name" && "$(realpath "$HOME/.local/bin/$name")" == "$SCRIPT_DIR/nitro-launcher" ]]; then
      rm -f "$HOME/.local/bin/$name"
    fi
    [[ -f "$INSTALL_BACKUP_HOME/bin-$name" ]] && cp -a "$INSTALL_BACKUP_HOME/bin-$name" "$HOME/.local/bin/$name"
  done
  for name in nitro-run nitro-gpu; do
    [[ -L "$HOME/.local/bin/$name" ]] && rm -f "$HOME/.local/bin/$name"
    [[ -f "$INSTALL_BACKUP_HOME/bin-$name" ]] && cp -a "$INSTALL_BACKUP_HOME/bin-$name" "$HOME/.local/bin/$name"
  done
  command -v update-desktop-database >/dev/null && update-desktop-database "$LOCAL_APPS" >/dev/null 2>&1 || true
  success "Wrappers e atalhos removidos; o repositório local foi preservado"
}

apply_profile() {
  local profile="$1" renderer
  case "$profile" in
    nvidia) renderer="$NVIDIA_RENDER" ;;
    intel|hybrid) renderer="$INTEL_RENDER" ;;
    *) die "Perfil inválido: $profile" ;;
  esac

  [[ -f "$NIRI_DEBUG" && -f "$NIRI_ENV" ]] || die "Configuração modular do Niri não encontrada em $NIRI_HOME"
  [[ "$profile" == nvidia ]] || ensure_intel_vulkan
  backup_files
  capture_originals

  info "Aplicando $(profile_name "$profile")..."
  # Faz a única operação privilegiada antes de alterar arquivos do usuário.
  # Se o sudo for cancelado, nenhuma configuração ativa fica parcialmente trocada.
  set_system_environment "$profile"
  set_niri_renderer "$renderer"
  set_niri_environment "$profile"
  set_heroic_profile "$profile"
  manage_gamescope_compatibility "$profile"
  validate_niri

  mkdir -p "$STATE_HOME"
  printf '%s\n' "$profile" >"$PROFILE_FILE"
  success "Perfil $(profile_name "$profile") aplicado"
  printf '\n%sÉ necessário encerrar e entrar novamente na sessão.%s\n' "$BOLD" "$RESET"
  printf '%sO script não encerra sua sessão automaticamente.%s\n' "$DIM" "$RESET"
}

menu() {
  show_status
  printf '\n%sEscolha um perfil:%s\n\n' "$BOLD" "$RESET"
  printf '  %s1%s  %s100%% NVIDIA%s       Desktop e jogos na GTX 1650\n' "$PURPLE" "$RESET" "$BOLD" "$RESET"
  printf '  %s2%s  %s100%% Intel%s         Desktop e jogos na Intel UHD\n' "$BLUE" "$RESET" "$BOLD" "$RESET"
  printf '  %s3%s  %sHíbrido recomendado%s Niri Intel, jogos NVIDIA\n' "$GREEN" "$RESET" "$BOLD" "$RESET"
  printf '  %s4%s  Apenas mostrar o estado\n' "$CYAN" "$RESET"
  printf '  %s5%s  Restaurar configuração original\n' "$YELLOW" "$RESET"
  printf '  %s6%s  Restaurar e desinstalar\n' "$RED" "$RESET"
  printf '  %s0%s  Sair\n\n' "$DIM" "$RESET"
  read -r -p "  Perfil › " choice
  case "$choice" in
    1) apply_profile nvidia ;;
    2) apply_profile intel ;;
    3) apply_profile hybrid ;;
    4) : ;;
    5) restore_originals ;;
    6) uninstall_switcher ;;
    0) exit 0 ;;
    *) die "Opção inválida." ;;
  esac
}

usage() {
  cat <<EOF
Uso: $(basename "$0") [comando]

  nvidia   Desktop e jogos na NVIDIA
  intel    Desktop e jogos na Intel
  hybrid   Niri na Intel e jogos na NVIDIA (recomendado)
  status   Exibe o perfil atual
  restore  Restaura o estado anterior à primeira alteração
  uninstall Restaura tudo e remove wrappers e atalhos
  menu     Abre o menu interativo
  version  Exibe a versão
EOF
}

main() {
  require_commands
  banner
  detect_hardware
  case "${1:-menu}" in
    nvidia|intel|hybrid) apply_profile "$1" ;;
    status) show_status ;;
    restore) restore_originals ;;
    uninstall) uninstall_switcher ;;
    menu) menu ;;
    version|--version|-v) printf '%s %s\n' "$APP_NAME" "$VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
